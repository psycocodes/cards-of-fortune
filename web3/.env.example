# Copy this to .env and replace with your actual values
# DO NOT COMMIT .env TO VERSION CONTROL

# Your test private key for Sepolia (get some test ETH from a faucet)
# Generate a new wallet or export from MetaMask for testing
SEPOLIA_PRIVATE_KEY=your_private_key_here

# Your Alchemy API key for Sepolia testnet
# Get this from https://dashboard.alchemy.com/
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here